{{!-- The Garden (apps/garden/page.js). --}}
{{#> agent-app-bar garden.bar}}
  {{#if @root.garden.me}}<a class="agent-inbox-owner agent-inbox-owner-link" data-action="garden-me" title="My Patch">{{owner}}</a>
  {{else if owner}}<span class="agent-inbox-owner">{{owner}}</span>{{/if}}
{{/agent-app-bar}}
{{#if garden.post}}
  <div class="agent-thread-bar"><a class="agent-icon-btn" data-action="garden-back" title="Back"><i class="fas fa-chevron-left"></i></a><span class="agent-thread-name">Post</span>
    {{#if garden.post.boost}}<span class="agent-garden-boost">{{> agent-dropdown garden.post.boost}}</span>{{/if}}</div>
  <div class="agent-info agent-garden">
    <ol class="agent-garden-feed">{{> agent-garden-post garden.post}}</ol>
    <ol class="agent-garden-replies">
      {{#each garden.post.replies}}
        <li class="agent-garden-reply">
          <a data-action="garden-profile" data-account-id="{{author.id}}"><b>{{author.name}}</b> <span class="agent-garden-handle">{{author.handle}}</span></a>
          <span class="agent-row-time">{{ago}}</span>
          {{#if canDelete}}<a class="agent-garden-reply-delete" data-action="garden-reply-delete" data-post-id="{{postId}}" data-reply-id="{{id}}" title="Delete reply"><i class="fas fa-trash"></i></a>{{/if}}
          <div>{{text}}</div>
        </li>
      {{else}}
        <li class="agent-empty">No replies yet.</li>
      {{/each}}
    </ol>
  </div>
  {{#if garden.gm}}
    <div class="agent-setting-row agent-garden-reply-as"><span>As</span>{{> agent-dropdown garden.replyAs}}</div>
    <div class="agent-garden-compose">
      <input type="text" name="gardenReply" data-live value="{{garden.replyDraft}}" placeholder="Reply…" {{#unless garden.online}}disabled{{/unless}}>
      <button type="button" data-action="garden-reply" data-post-id="{{garden.post.id}}" {{#unless garden.online}}disabled{{/unless}}><i class="fas fa-reply"></i></button>
    </div>
  {{else if garden.me}}
    <div class="agent-garden-compose">
      <input type="text" name="gardenReply" data-live value="{{garden.replyDraft}}" placeholder="Reply as {{garden.me.handle}}…" {{#unless garden.online}}disabled{{/unless}}>
      <button type="button" data-action="garden-reply" data-post-id="{{garden.post.id}}" {{#unless garden.online}}disabled{{/unless}}><i class="fas fa-reply"></i></button>
    </div>
  {{/if}}
{{else if garden.patch}}
  <div class="agent-thread-bar"><a class="agent-icon-btn" data-action="garden-back" title="Back"><i class="fas fa-chevron-left"></i></a><span class="agent-thread-name">{{garden.patch.handle}}</span></div>
  <div class="agent-info agent-garden">
    <div class="agent-garden-patch kind-{{garden.patch.kind}}">
      {{#if garden.patch.avatar}}<img class="agent-avatar" src="{{garden.patch.avatar}}" alt="">{{else}}<span class="agent-avatar">{{garden.patch.initials}}</span>{{/if}}
      <div class="agent-card-name">{{garden.patch.name}}{{#if garden.patch.verified}} <i class="fas fa-seedling agent-garden-verified"></i>{{/if}}</div>
      <div class="agent-garden-handle">{{garden.patch.handle}} · {{garden.patch.kindName}}</div>
      {{#if garden.patch.bio}}<p class="agent-garden-bio">{{garden.patch.bio}}</p>{{/if}}
      <div class="agent-garden-stats"><b>{{garden.patch.followersLabel}}</b> followers{{#if garden.patch.reputation includeZero=true}} · <b>REP {{garden.patch.reputation}}</b>{{/if}}</div>
      {{#if garden.patch.mine}}<a class="agent-card-more" data-action="garden-edit-me"><i class="fas fa-pen"></i> Edit my Patch</a>{{/if}}
      {{#if garden.patch.canMessage}}<button type="button" class="agent-wide-btn agent-garden-cta" data-action="garden-message" data-account-id="{{garden.patch.id}}"><i class="{{@root.appearance.icons.messages}}"></i> Message</button>{{/if}}
    </div>
    {{#if garden.patch.repFeed.length}}
      <h3 class="agent-info-label">Street rep (from the sheet)</h3>
      <ol class="agent-app-list">{{#each garden.patch.repFeed}}<li class="agent-app-item compact"><div class="agent-app-item-main"><small>{{this}}</small></div></li>{{/each}}</ol>
    {{/if}}
    <ol class="agent-garden-feed" data-short-list="garden-patch-posts">
      {{#each garden.patch.posts}}{{> agent-garden-post}}{{else}}<li class="agent-empty">Nothing posted.</li>{{/each}}
    </ol>
    {{#if garden.patch.replies.length}}
      <h3 class="agent-info-label">Replies</h3>
      <ol class="agent-garden-replies" data-short-list="garden-patch-replies">
        {{#each garden.patch.replies}}
          <li class="agent-garden-reply">
            <a data-action="garden-open" data-post-id="{{postId}}"><span class="agent-garden-handle">Replying to {{to}}</span></a>
            <span class="agent-row-time">{{ago}}</span>
            {{#if canDelete}}<a class="agent-garden-reply-delete" data-action="garden-reply-delete" data-post-id="{{postId}}" data-reply-id="{{id}}" title="Delete reply"><i class="fas fa-trash"></i></a>{{/if}}
            <div class="agent-garden-reply-to" data-action="garden-open" data-post-id="{{postId}}">{{toText}}</div>
            <div>{{text}}</div>
          </li>
        {{/each}}
      </ol>
    {{/if}}
  </div>
{{else}}
  <div class="agent-tabs">
    {{#each garden.tabs}}<a class="agent-tab{{#if active}} active{{/if}}" data-action="garden-tab" data-tab="{{id}}">{{label}}</a>{{/each}}
  </div>
  {{#if garden.show.feed}}
    <div class="agent-info agent-garden">
      {{#if garden.canPost}}
        <div class="agent-garden-composer">
          {{#if garden.gm}}<div class="agent-setting-row"><span>As</span>{{> agent-dropdown garden.as}}</div>{{/if}}
          <textarea name="gardenPost" rows="2" aria-label="New post" placeholder="{{#if garden.gm}}What's Night City talking about?{{else}}Post as {{garden.me.handle}}…{{/if}}" {{#unless garden.online}}disabled{{/unless}}>{{garden.draft}}</textarea>
          {{#if garden.image}}<div class="agent-pending-location"><i class="{{@root.appearance.icons.photo}}"></i> Picture attached <a data-action="garden-photo-clear" title="Remove"><i class="fas fa-xmark"></i></a></div>{{/if}}
          {{#if garden.rep}}<div class="agent-pending-location"><i class="fas fa-star"></i> <a data-action="garden-rep" title="Change">#rep {{garden.rep}}</a> <a data-action="garden-rep-clear" title="Remove"><i class="fas fa-xmark"></i></a></div>{{/if}}
          <div class="agent-garden-composer-row">
            <a class="agent-icon-btn" data-action="garden-photo" title="Attach a picture"><i class="{{@root.appearance.icons.photo}}"></i></a>
            {{#if garden.gm}}
              <a class="agent-icon-btn" data-action="garden-rep" title="Tag as a Reputation event about characters"><i class="fas fa-star"></i></a>
              {{> agent-dropdown garden.tier}}
              <input type="number" name="gardenDelay" min="0" value="0" title="Post in this many in-game minutes (0: now)" aria-label="Delay in in-game minutes">
              <small>min</small>
            {{/if}}
            <button type="button" class="agent-garden-post-btn" data-action="garden-post" {{#unless garden.online}}disabled{{/unless}}><i class="fas fa-seedling"></i> Post</button>
          </div>
        </div>
      {{else}}
        <div class="agent-garden-join">
          <span>Everyone can read the Garden. To post, sprout and reply, you need a Patch.</span>
          <button type="button" class="agent-wide-btn agent-garden-cta" data-action="garden-join" {{#unless garden.online}}disabled{{/unless}}><i class="fas fa-seedling"></i> Make an account</button>
        </div>
      {{/if}}
      <ol class="agent-garden-feed">
        {{#each garden.feed}}{{> agent-garden-post}}{{else}}<li class="agent-empty">Nothing here yet.</li>{{/each}}
      </ol>
    </div>
  {{/if}}

  {{#if garden.show.dating}}
    <div class="agent-info agent-garden agent-dating">
      {{#if garden.gm}}
        <h3 class="agent-info-label">The Algorithm is searching</h3>
        <ol class="agent-app-list">
          {{#each garden.dating.searching}}
            <li class="agent-app-item compact"><div class="agent-app-item-main"><b>{{who}}</b> activated the Algorithm</div>
              <a class="agent-app-chip" data-action="dating-suggest" data-spark-id="{{id}}"><i class="fas fa-wand-magic-sparkles"></i> Pick who it finds</a></li>
          {{else}}<li class="agent-empty">Nobody's searching.</li>{{/each}}
        </ol>
        <h3 class="agent-info-label">Matches</h3>
        <ol class="agent-app-list">
          {{#each garden.dating.matches}}
            <li class="agent-app-item compact"><div class="agent-app-item-main"><b>{{who}}</b> ♥ {{handle}}{{#if @root.garden.dating.comms}}{{#if contact}}<small>In Messages as {{contact}}</small>{{/if}}{{/if}}</div>
              {{#if @root.garden.dating.comms}}<a class="agent-app-chip" data-action="dating-text" data-spark-id="{{id}}"><i class="fas fa-champagne-glasses"></i> Text them</a>{{/if}}</li>
          {{else}}<li class="agent-empty">No matches yet.</li>{{/each}}
        </ol>
        <h3 class="agent-info-label">Profiles
          <a class="agent-icon-btn" data-action="dating-profile-edit" title="New profile"><i class="fas fa-plus"></i></a>
          <a class="agent-icon-btn" data-action="dating-generate" title="Random profiles"><i class="fas fa-dice"></i></a></h3>
        <ol class="agent-app-list" data-short-list="garden-dating-profiles">
          {{#each garden.dating.profiles}}
            <li class="agent-app-item compact">
              {{#if avatar}}<img class="agent-avatar" src="{{avatar}}" alt="">{{else}}<span class="agent-avatar">{{initials}}</span>{{/if}}
              <div class="agent-app-item-main"><b>{{handle}}</b> {{name}}, {{age}}<small>{{#if player}}{{player}}'s profile{{else}}{{#if npc}}{{npc}} · {{/if}}{{prompts.[0]}}{{/if}}</small></div>
              {{#unless player}}
                <a class="agent-icon-btn" data-action="dating-profile-edit" data-profile-id="{{id}}" title="Edit"><i class="fas fa-pen"></i></a>
                <a class="agent-icon-btn" data-action="dating-profile-delete" data-profile-id="{{id}}" title="Delete"><i class="fas fa-trash"></i></a>
              {{/unless}}
            </li>
          {{else}}<li class="agent-empty">No profiles. Write some, or make random ones.</li>{{/each}}
        </ol>
      {{else}}
        {{#if garden.dating.mine}}
          {{#if garden.dating.found}}
            <div class="agent-dating-card found">
              <div class="agent-dating-found"><i class="fas fa-wand-magic-sparkles"></i> The Algorithm found someone</div>
              {{#if garden.dating.found.avatar}}<img class="agent-dating-photo" src="{{garden.dating.found.avatar}}" alt="">{{else}}<span class="agent-dating-photo">{{garden.dating.found.initials}}</span>{{/if}}
              <div class="agent-dating-name"><b>{{garden.dating.found.name}}</b>, {{garden.dating.found.age}} <span class="agent-garden-handle">{{garden.dating.found.handle}}</span></div>
              <ol class="agent-dating-prompts">{{#each garden.dating.found.prompts}}<li>{{this}}</li>{{/each}}</ol>
              <div class="agent-dating-actions">
                <a class="agent-dating-pass" data-action="dating-respond" data-spark-id="{{garden.dating.found.sparkId}}" data-spark="false"><i class="fas fa-xmark"></i> No spark</a>
                <a class="agent-dating-spark" data-action="dating-respond" data-spark-id="{{garden.dating.found.sparkId}}" data-spark="true"><i class="fas fa-bolt"></i> Spark</a>
              </div>
            </div>
          {{else}}
            <div class="agent-algorithm">
              <a class="agent-algorithm-btn{{#if garden.dating.searching}} searching{{/if}}" {{#unless garden.dating.searching}}data-action="dating-algorithm"{{/unless}}>
                <i class="fas fa-wand-magic-sparkles"></i>
                <span>{{#if garden.dating.searching}}Searching…{{else}}Activate the Algorithm{{/if}}</span>
              </a>
              <p class="agent-info-note">{{#if garden.dating.searching}}The Algorithm is looking for someone for you.{{else}}Let The Garden find someone for you.{{/if}}</p>
            </div>
          {{/if}}
          {{#if garden.dating.matches.length}}
            <h3 class="agent-info-label">Matches</h3>
            <ol class="agent-app-list">
              {{#each garden.dating.matches}}
                <li class="agent-app-item compact">
                  {{#if avatar}}<img class="agent-avatar" src="{{avatar}}" alt="">{{else}}<span class="agent-avatar">{{initials}}</span>{{/if}}
                  <div class="agent-app-item-main"><b>{{name}}</b> {{handle}}<small>Matched</small></div>
                  {{#if canMessage}}<a class="agent-app-chip" data-action="dating-message" data-spark-id="{{id}}"><i class="{{@root.appearance.icons.messages}}"></i> {{@root.garden.dating.openLabel}}</a>{{/if}}
                  <a class="agent-icon-btn" data-action="dating-unmatch" data-spark-id="{{id}}" title="Delete match"><i class="fas fa-trash"></i></a>
                </li>
              {{/each}}
            </ol>
          {{/if}}
          {{> agent-dating-edit garden.dating.mine}}
        {{else}}
          <div class="agent-garden-join">
            <span>The Garden Dating: let the Algorithm find you someone.</span>
            {{#if garden.dating.canLink}}
              <button type="button" class="agent-wide-btn agent-garden-cta agent-dating-cta" data-action="dating-create" data-link="true"><i class="fas fa-link"></i> Use my Garden Patch</button>
            {{else}}
              <button type="button" class="agent-wide-btn agent-garden-cta agent-dating-cta" data-action="dating-create" data-link="false"><i class="fas fa-heart"></i> Create a dating profile</button>
            {{/if}}
          </div>
        {{/if}}
      {{/if}}
    </div>
  {{/if}}

  {{#if garden.show.accounts}}
    <div class="agent-info agent-garden">
      <div class="agent-btn-row">
        <button type="button" class="agent-wide-btn" data-action="garden-account-edit"><i class="fas fa-plus"></i> New account</button>
        <button type="button" class="agent-wide-btn" data-action="garden-generate"><i class="fas fa-dice"></i> Random citizens</button>
      </div>
      <ol class="agent-app-list" data-short-list="garden-accounts">
        {{#each garden.accounts}}
          <li class="agent-app-item compact">
            {{#if avatar}}<img class="agent-avatar" src="{{avatar}}" alt="">{{else}}<span class="agent-avatar">{{initials}}</span>{{/if}}
            <a class="agent-app-item-main" data-action="garden-profile" data-account-id="{{id}}"><b>{{handle}}</b>{{#if verified}} <i class="fas fa-seedling agent-garden-verified"></i>{{/if}}<small>{{name}} · {{kindName}} · {{followersLabel}}{{#if owner}} · {{owner}}{{/if}}{{#if npc}} · {{npc}}{{/if}}{{#if attitude}} · <i class="fas fa-face-smile"></i> {{attitude}}{{/if}}</small></a>
            <a class="agent-icon-btn{{#if pinned}} active{{/if}}" data-action="garden-pin" data-account-id="{{id}}" title="{{#if pinned}}Pinned: first in the As list. Unpin{{else}}Pin: first in the As list{{/if}}"><i class="fas fa-thumbtack"></i></a>
            {{#unless actorId}}
              <a class="agent-icon-btn" data-action="garden-post-as" data-account-id="{{id}}" title="Post as {{handle}}"><i class="fas fa-pen-nib"></i></a>
              <a class="agent-icon-btn" data-action="garden-account-edit" data-account-id="{{id}}" title="Edit"><i class="fas fa-pen"></i></a>
              <a class="agent-icon-btn{{#if profiled}} active{{/if}}" data-action="garden-writer-edit" data-account-id="{{id}}" title="Writer profile{{#if profiled}} (set){{/if}}"><i class="fas fa-feather"></i></a>
            {{/unless}}
            <a class="agent-icon-btn" data-action="garden-account-delete" data-account-id="{{id}}" title="Delete"><i class="fas fa-trash"></i></a>
          </li>
        {{/each}}
      </ol>
    </div>
  {{/if}}

  {{#if garden.show.drafts}}{{> agent-garden-drafts garden.drafts}}{{/if}}

  {{#if garden.show.writer}}
    <div class="agent-info agent-garden agent-garden-writer">
      <div class="agent-btn-row">
        <button type="button" class="agent-wide-btn" data-action="garden-log-event"><i class="fas fa-bolt"></i> Log an event</button>
        <button type="button" class="agent-wide-btn" data-action="garden-plant-seed"><i class="fas fa-seedling"></i> Plant a seed</button>
      </div>
      <a class="agent-card-more" data-action="garden-macro"><i class="fas fa-bolt"></i> Put "Log an event" on my hotbar</a>

      <h3 class="agent-info-label">Events</h3>
      <ol class="agent-app-list" data-short-list="garden-happenings">
        {{#each garden.writer.happenings}}
          <li class="agent-app-item compact{{#if closed}} faded{{/if}}">
            <div class="agent-app-item-main"><b>{{what}}</b><small>{{#if place}}{{place}} · {{/if}}{{when}} · {{heatName}}{{#unless public}} · <i class="fas fa-eye-slash" title="GM-only"></i>{{/unless}}{{#if whoNames}} · {{whoNames}}{{/if}}</small></div>
            <a class="agent-garden-stage" data-action="garden-stage" data-kind="happening" data-id="{{id}}" title="Move it on">{{stageName}}</a>
            <a class="agent-icon-btn" data-action="garden-happening-edit" data-id="{{id}}" title="Edit"><i class="fas fa-pen"></i></a>
            <a class="agent-icon-btn" data-action="garden-happening-delete" data-id="{{id}}" title="Forget"><i class="fas fa-trash"></i></a>
          </li>
        {{else}}
          <li class="agent-empty">Nothing logged. Log what happened in the story; the writer follows it up.</li>
        {{/each}}
      </ol>

      <h3 class="agent-info-label">Seeds</h3>
      <ol class="agent-app-list" data-short-list="garden-seeds">
        {{#each garden.writer.seeds}}
          <li class="agent-app-item compact{{#if done}} faded{{/if}}">
            <div class="agent-app-item-main"><b>{{what}}</b><small>{{obviousName}}{{#if byLabel}} · by {{byLabel}}{{/if}}{{#if keywords.length}} · {{#each keywords}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{/if}}</small></div>
            <a class="agent-garden-stage" data-action="garden-stage" data-kind="seed" data-id="{{id}}" title="Move it on">{{stageName}}</a>
            <a class="agent-icon-btn" data-action="garden-seed-edit" data-id="{{id}}" title="Edit"><i class="fas fa-pen"></i></a>
            <a class="agent-icon-btn" data-action="garden-seed-delete" data-id="{{id}}" title="Forget"><i class="fas fa-trash"></i></a>
          </li>
        {{else}}
          <li class="agent-empty">No seeds. Plant what you want the city to start talking about before it matters.</li>
        {{/each}}
      </ol>

      <h3 class="agent-info-label">Characters <a class="agent-icon-btn" data-action="garden-writer-pc-add" title="Add a character"><i class="fas fa-plus"></i></a></h3>
      <p class="agent-info-note">{{garden.writer.pcsNote}}{{#if garden.writer.pcsOut.length}} Left out: {{#each garden.writer.pcsOut}}{{name}}{{#unless @last}}, {{/unless}}{{/each}}.{{/if}}</p>
      <ol class="agent-app-list" data-short-list="garden-pcs">
        {{#each garden.writer.pcs}}
          <li class="agent-app-item compact">
            <div class="agent-app-item-main"><b>{{name}}</b><small>{{#if keywords}}{{keywords}}{{else}}No keywords yet{{/if}}</small></div>
            <a class="agent-icon-btn{{#if set}} active{{/if}}" data-action="garden-writer-pc" data-actor-id="{{id}}" title="Writer profile"><i class="fas fa-feather"></i></a>
            <a class="agent-icon-btn" data-action="garden-writer-pc-remove" data-actor-id="{{id}}" title="Remove from the writer's list"><i class="fas fa-xmark"></i></a>
          </li>
        {{/each}}
      </ol>

      <h3 class="agent-info-label">Cast, corps and voices</h3>
      <ol class="agent-app-list" data-short-list="garden-cast">
        {{#each garden.writer.cast}}
          <li class="agent-app-item compact">
            <a class="agent-app-item-main" data-action="garden-profile" data-account-id="{{id}}"><b>{{handle}}</b><small>{{#if arc}}{{arc}} · {{/if}}{{keywords}}{{#if lines}} · {{lines}} own replies{{/if}}</small></a>
            <a class="agent-icon-btn active" data-action="garden-writer-edit" data-account-id="{{id}}" title="Writer profile"><i class="fas fa-feather"></i></a>
          </li>
        {{else}}
          <li class="agent-empty">No profiles yet. Give an account keywords with <i class="fas fa-feather"></i> in Accounts.</li>
        {{/each}}
      </ol>

      <h3 class="agent-info-label">Recurring posts <a class="agent-icon-btn" data-action="garden-format-edit" title="New recurring post"><i class="fas fa-plus"></i></a></h3>
      <ol class="agent-app-list">
        {{#each garden.writer.formats}}
          <li class="agent-app-item compact">
            <div class="agent-app-item-main"><b>{{handle}}</b> <span class="agent-row-time">{{when}}</span><small>{{what}}</small></div>
            <a class="agent-icon-btn" data-action="garden-format-edit" data-id="{{id}}" title="Edit"><i class="fas fa-pen"></i></a>
            <a class="agent-icon-btn" data-action="garden-format-delete" data-id="{{id}}" title="Delete"><i class="fas fa-trash"></i></a>
          </li>
        {{else}}
          <li class="agent-empty">None. The stringer's morning headlines, Roach's weekly post, the band's gig listing...</li>
        {{/each}}
      </ol>

      <h3 class="agent-info-label">Writer feeds</h3>
      <ol class="agent-app-list">
        {{#each garden.writer.feeds}}
          <li class="agent-app-item compact{{#unless on}} faded{{/unless}}">
            <div class="agent-app-item-main"><b>{{name}}</b><small>{{#if on}}In the pack{{else}}Off{{/if}}{{#if keywords}} · {{keywords}}{{/if}}{{#if accounts}} · {{accounts}}{{/if}}</small></div>
            <a class="agent-icon-btn" data-action="garden-feed-edit" data-app="{{app}}" title="Edit"><i class="fas fa-pen"></i></a>
          </li>
        {{/each}}
      </ol>

      <h3 class="agent-info-label">Mix <a class="agent-icon-btn" data-action="garden-mix-edit" title="Edit"><i class="fas fa-pen"></i></a></h3>
      <p class="agent-info-note">City {{garden.writer.mix.city}}% · Close to home {{garden.writer.mix.close}}% · About them {{garden.writer.mix.about}}%</p>
      <p class="agent-info-note">The garden-writer skill (Claude Code) reads all of this. Players never see it.</p>
    </div>
  {{/if}}

  {{#if garden.show.control}}
    <div class="agent-info agent-garden">
      <h3 class="agent-info-label">Pages</h3>
      <label class="agent-radio"><input type="checkbox" data-garden-setting="mergeNews" {{#if garden.control.mergeNews}}checked{{/if}}> Merge Feed &amp; News</label>
      <label class="agent-radio"><input type="checkbox" data-garden-setting="dating" {{#if garden.control.dating}}checked{{/if}}> The Garden Dating</label>

      <h3 class="agent-info-label">Outcomes <a class="agent-icon-btn" data-action="garden-tier-edit" title="New outcome"><i class="fas fa-plus"></i></a></h3>
      <ol class="agent-app-list">
        {{#each garden.control.tiers}}
          <li class="agent-app-item compact">
            <div class="agent-app-item-main"><b>{{name}}</b> <small>{{summary}} · chance {{weight}}</small></div>
            <a class="agent-icon-btn" data-action="garden-tier-edit" data-tier="{{id}}" title="Edit"><i class="fas fa-pen"></i></a>
            <a class="agent-icon-btn" data-action="garden-tier-delete" data-tier="{{id}}" title="Delete"><i class="fas fa-trash"></i></a>
          </li>
        {{/each}}
      </ol>
      <a class="agent-card-more" data-action="garden-tier-reset">Back to the default outcomes</a>
      <p class="agent-info-note">How far and how fast a post blows up. Sprouts are about 11% of who sees it (the author's followers × reach); grafts about 2%. "Mostly within" is real minutes; on in-game time a post takes ten times as long, and grows by whichever is further along.</p>

      <h3 class="agent-info-label">Word lists</h3>
      <p class="agent-info-note">Everything the Garden makes up comes from text files, one entry per line (lines starting with # are notes). Each uses the module's own file until you pick yours: <b>Choose</b> opens the file picker, where you can also upload one. Copy the module's file from <em>modules/cpr-sam-agent/data/garden/</em> to start from it.</p>
      <ol class="agent-app-list">
        {{#each garden.control.lists}}
          <li class="agent-app-item compact">
            <div class="agent-app-item-main"><b>{{label}}</b> <small>{{count}} · {{#if path}}{{path}}{{else}}built in ({{file}}){{/if}}</small><small class="agent-list-sample">{{sample}}</small></div>
            <a class="agent-icon-btn" data-action="garden-list-view" data-list="{{key}}" title="Read it"><i class="fas fa-eye"></i></a>
            <a class="agent-icon-btn" data-action="garden-list-file" data-list="{{key}}" title="Choose or upload your own file"><i class="fas fa-file-import"></i></a>
            {{#if path}}<a class="agent-icon-btn" data-action="garden-list-reset" data-list="{{key}}" title="Back to the built-in file"><i class="fas fa-rotate-left"></i></a>{{/if}}
          </li>
        {{/each}}
      </ol>
    </div>
  {{/if}}

  {{#if garden.show.queue}}
    <div class="agent-info agent-garden">
      <div class="agent-btn-row">
        <button type="button" class="agent-wide-btn" data-action="garden-drip"><i class="fas fa-list"></i> Queue posts</button>
        {{#if garden.queue.paused}}
          <button type="button" class="agent-wide-btn" data-action="garden-queue" data-op="resume"><i class="fas fa-play"></i> Resume</button>
        {{else}}
          <button type="button" class="agent-wide-btn" data-action="garden-queue" data-op="pause"><i class="fas fa-pause"></i> Pause</button>
        {{/if}}
      </div>
      <ol class="agent-app-list">
        {{#each garden.queue.items}}
          <li class="agent-app-item compact">
            <div class="agent-app-item-main"><b>{{author.handle}}</b> <span class="agent-row-time">{{inLabel}}</span><small>{{#if image}}<i class="fas fa-image" title="{{image}}"></i> {{/if}}{{text}}{{#if outcome}} · <em>{{outcome}}</em>{{/if}}</small></div>
            <a class="agent-icon-btn" data-action="garden-queue-edit" data-id="{{id}}" title="Edit"><i class="fas fa-pen"></i></a>
            <a class="agent-icon-btn{{#if first}} disabled{{/if}}" data-action="garden-queue" data-op="up" data-id="{{id}}" title="Earlier"><i class="fas fa-arrow-up"></i></a>
            <a class="agent-icon-btn{{#if last}} disabled{{/if}}" data-action="garden-queue" data-op="down" data-id="{{id}}" title="Later"><i class="fas fa-arrow-down"></i></a>
            <a class="agent-icon-btn" data-action="garden-queue" data-op="now" data-id="{{id}}" title="Post now"><i class="fas fa-paper-plane"></i></a>
            <a class="agent-icon-btn" data-action="garden-queue" data-op="remove" data-id="{{id}}" title="Skip"><i class="fas fa-xmark"></i></a>
          </li>
        {{else}}
          <li class="agent-empty">Nothing queued. Posts with a delay, and queued lists, wait here.</li>
        {{/each}}
      </ol>
      <p class="agent-info-note">Queued posts go out on the phones' clock: in-game time when it follows the world (Simple Calendar, SmallTime), else real time. Move the clock on and everything due goes out at once, each dated when it was due. Pause holds the queue where it is.</p>
      <p class="agent-info-note"><b>Queue posts</b> takes one post per line: <em>@handle | text | picture | outcome</em>. Only the text is needed.</p>
      <ul class="agent-info-note agent-help-list">
        <li><em>@handle</em>: who posts it. <em>@random</em> picks a random citizen when it goes out. Leave it off to post as the dialog's "No handle posts as": a random citizen, or the composer's "As". A handle nobody has yet becomes a new citizen.</li>
        <li><em>picture</em>: a picture's path on the server (e.g. <em>worlds/my-world/pics/fire.webp</em>, as the file browser shows it) or a web link (<em>https://…</em>). Leave it empty for none: <em>@network54 | Fire in Watson | | viral</em>.</li>
        <li><em>outcome</em>: one from Control (e.g. viral); empty picks one at random.</li>
      </ul>
      <p class="agent-info-note"><b>Queue posts</b> can start from a .txt file on your computer (same lines). The pen edits any queued post.</p>
    </div>
  {{/if}}
{{/if}}
