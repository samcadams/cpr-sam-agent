{{!-- WatchBox (apps/watchbox/page.js). Armed, it's the whole phone. --}}
{{#if watchbox.armed}}
  <div class="agent-watchbox{{#if watchbox.alarm}} alarm{{/if}}{{#if watchbox.assessing}} assessing{{/if}}">
    <div class="agent-watchbox-eye"><i></i></div>
    <div class="agent-watchbox-status">
      {{#if watchbox.alarm}}INTRUSION{{else if watchbox.assessing}}ASSESSING <span {{#if watchbox.endsAt}}data-eta="{{watchbox.endsAt}}"{{/if}}>{{watchbox.countdown}}</span>{{else}}ARMED{{/if}}
    </div>
    <div class="agent-watchbox-brand">WatchBox · No/Brainer</div>
    {{#if watchbox.assessing}}<p class="agent-info-note">Five minutes to learn the room (real time, or sooner if the GM moves the clock on). Whoever's here now is known.</p>{{/if}}
    {{#if watchbox.near}}
      <button type="button" class="agent-wide-btn" data-action="wb-disarm"><i class="fas fa-hand"></i> Pick it up (disarm)</button>
    {{else}}
      <p class="agent-info-note">Your Agent is back in the room, watching. Go back to it to disarm.</p>
    {{/if}}
  </div>
{{else}}
  {{> agent-app-bar watchbox.bar}}
  <div class="agent-info agent-app agent-wb">
    {{#if watchbox.gm}}
      <h3 class="agent-info-label">Armed</h3>
      <ol class="agent-app-list">
        {{#each watchbox.watches}}
          <li class="agent-app-item status-{{status}}">
            <i class="fas fa-eye agent-app-item-icon"></i>
            <div class="agent-app-item-main">
              <div class="agent-app-item-top"><b>{{name}}'s Agent</b><span class="agent-row-time">{{scene}}</span></div>
              <small>{{#if assessing}}Assessing the room{{else if alarm}}ALARM SOUNDING{{else}}Armed{{/if}}</small>
              <div class="agent-money-actions">
                {{#if assessing}}<a data-action="wb-skip" data-actor-id="{{actorId}}"><i class="fas fa-forward"></i> Done assessing</a>{{/if}}
                {{#if alarm}}<a data-action="wb-silence" data-actor-id="{{actorId}}"><i class="fas fa-volume-xmark"></i> Silence</a>
                {{else}}{{#unless assessing}}<a class="pay" data-action="wb-trigger" data-actor-id="{{actorId}}" title="A noise or a flash of light"><i class="fas fa-bell"></i> Trigger</a>{{/unless}}{{/if}}
                <a class="decline" data-action="wb-disarm" data-actor-id="{{actorId}}">Disarm</a>
              </div>
            </div>
          </li>
        {{else}}
          <li class="agent-empty">No WatchBox armed.</li>
        {{/each}}
      </ol>
      <p class="agent-info-note">The square is a hidden template you can move or resize.</p>
    {{else}}
      <div class="agent-watchbox idle">
        <div class="agent-watchbox-eye"><i></i></div>
        <div class="agent-watchbox-brand">WatchBox · No/Brainer</div>
      </div>
      <p class="agent-info-note">Leave your Agent in the middle of a room (up to 20 × 20 m). After 5 minutes learning it, anyone new who moves in it sets off a loud alarm, unless they beat a DV13 Stealth check. It stops if the Agent is moved, and doesn't tell you remotely: you have to hear it.</p>
      {{#if watchbox.internal}}
        <p class="agent-info-note">WatchBox doesn't work on an Internal Agent.</p>
      {{else}}
        <button type="button" class="agent-wide-btn" data-action="wb-arm"><i class="fas fa-eye"></i> Arm WatchBox</button>
      {{/if}}
    {{/if}}
  </div>
{{/if}}
