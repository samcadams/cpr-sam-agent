{{!-- The Agent app (apps/agent/page.js). --}}
{{> agent-app-bar agentApp.bar}}
<div class="agent-info agent-app agent-agent">
  {{#if agentApp.gm}}
    <h3 class="agent-info-label">Send an SAAI alert</h3>
    <ol class="agent-members agent-pick-list">
      <li class="agent-member-link{{#if agentApp.allOn}} on{{/if}}" data-action="alert-target" data-actor-id="all">
        <i class="fas {{#if agentApp.allOn}}fa-square-check{{else}}fa-square{{/if}}"></i> <span class="agent-member-name">Everyone</span>
      </li>
      {{#each agentApp.characters}}
        <li class="agent-member-link{{#if on}} on{{/if}}" data-action="alert-target" data-actor-id="{{id}}">
          <i class="fas {{#if on}}fa-square-check{{else}}fa-square{{/if}}"></i>
          {{> agent-avatar}}
          <span class="agent-member-name">{{name}}<small>{{agent}} · {{personality}}</small></span>
        </li>
      {{else}}
        <li class="agent-empty">No player characters.</li>
      {{/each}}
    </ol>
    <div class="agent-setting-row"><span>Kind</span>{{> agent-dropdown agentApp.kind}}</div>
    <textarea name="alertText" rows="3" aria-label="Alert text" placeholder="I have a bad feeling about this place…">{{agentApp.draft.text}}</textarea>
    <input type="text" name="alertChoices" aria-label="Answers, comma separated" value="{{agentApp.draft.choices}}" placeholder="Answers, comma separated (optional): Book it, Not now">
    <div class="agent-btn-row">
      <button type="button" class="agent-wide-btn" data-action="alert-send"><i class="fas fa-paper-plane"></i> Send</button>
      <button type="button" class="agent-wide-btn" data-action="alert-save" title="Keep it for next time"><i class="fas fa-bookmark"></i> Save</button>
    </div>

    {{#if agentApp.saved.length}}
      <h3 class="agent-info-label">Saved</h3>
      <ol class="agent-app-list" data-short-list="agent-saved">
        {{#each agentApp.saved}}
          <li class="agent-app-item compact">
            <a class="agent-app-item-main" data-action="alert-load" data-index="{{index}}"><small>{{kindName}}</small> {{text}}</a>
            <a class="agent-icon-btn" data-action="alert-unsave" data-index="{{index}}" title="Forget"><i class="fas fa-xmark"></i></a>
          </li>
        {{/each}}
      </ol>
    {{/if}}
    <h3 class="agent-info-label">Sent</h3>
  {{else}}
    <h3 class="agent-info-label">Your Agent</h3>
    <div class="agent-setting-row"><span>Name</span><input type="text" name="agentName" value="{{agentApp.name}}" placeholder="{{agentApp.placeholder}}" maxlength="24"></div>
    <div class="agent-setting-row"><span>Personality</span>{{> agent-dropdown agentApp.personality}}</div>
    {{#if agentApp.custom}}
      <textarea name="personalityText" rows="2" placeholder="How does it talk? The GM reads this.">{{agentApp.personalityText}}</textarea>
    {{else if agentApp.voice}}
      <p class="agent-info-note">{{agentApp.voice}}</p>
    {{/if}}

    {{#if agentApp.biomonitor}}
      <h3 class="agent-info-label">Biometrics</h3>
      {{#if agentApp.vitals}}
        <div class="agent-vitals-tile state-{{agentApp.vitals.state}}">
          <span><i class="fas fa-heart-pulse"></i> HP <b>{{agentApp.vitals.hp}}/{{agentApp.vitals.max}}</b></span>
          {{#if agentApp.vitals.body}}<span>BODY <b>{{agentApp.vitals.body}}</b></span>{{/if}}
          <span class="agent-vitals-state">{{agentApp.vitals.stateLabel}}</span>
          {{#if agentApp.vitals.injury}}<span class="agent-vitals-injury"><i class="fas fa-bone"></i> {{agentApp.vitals.injury}}</span>{{/if}}
        </div>
      {{/if}}
      <label class="agent-radio"><input type="checkbox" name="biometrics" {{#if agentApp.biometrics}}checked{{/if}}> Warn me when I'm badly hurt</label>
    {{/if}}
    <h3 class="agent-info-label">Notifications</h3>
  {{/if}}

  <ol class="agent-app-list" data-short-list="agent-alerts">
    {{#each agentApp.alerts}}
      <li class="agent-app-item agent-alert kind-{{kind}}{{#if open}} open{{/if}}"{{#if open}} data-keep{{/if}}>
        <i class="fas {{icon}} agent-app-item-icon"></i>
        <div class="agent-app-item-main">
          <div class="agent-app-item-top"><b>{{from}}</b>{{#if owner}} → {{owner}}{{/if}}<span class="agent-row-time">{{time}}</span></div>
          <div>{{text}}</div>
          {{#if answer}}<div class="agent-alert-answer"><i class="fas fa-reply"></i> {{answer}}</div>{{/if}}
          {{#if app}}<a class="agent-alert-open" data-action="app" data-app="{{app.id}}">Open {{app.name}} <i class="fas fa-chevron-right"></i></a>{{/if}}
          {{#if open}}{{#unless ../agentApp.gm}}
            <div class="agent-money-actions">
              {{#each choices}}<a class="{{#if @first}}pay{{else}}decline{{/if}}" data-action="alert-answer" data-alert-id="{{../id}}" data-choice="{{this}}">{{this}}</a>{{/each}}
            </div>
          {{/unless}}{{/if}}
        </div>
        {{#unless open}}<a class="agent-icon-btn agent-app-item-x" data-action="alert-dismiss" data-alert-id="{{id}}" title="Clear"><i class="fas fa-xmark"></i></a>{{/unless}}
      </li>
    {{else}}
      <li class="agent-empty">Nothing yet.</li>
    {{/each}}
  </ol>
</div>
