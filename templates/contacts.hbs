<div class="ctp-contacts-body">
  <div class="ctp-character-row">
    <label>Character</label>
    <select class="ctp-character-select">
      {{#each characters}}
        <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
      {{/each}}
    </select>
  </div>

  <p class="notes">Drag actors onto this window to add them, or add a custom contact. Click a portrait to change it. Blocked numbers can't be texted or called by the player; "texts only" contacts can be texted but not called.</p>

  <ol class="ctp-contacts-list">
    {{#each contacts}}
      <li class="ctp-contact" data-index="{{index}}">
        <img class="ctp-contact-img" src="{{img}}" title="Change image">
        <input type="text" class="ctp-contact-name" value="{{name}}">
        <a class="ctp-contact-call{{#if noCall}} active{{/if}}" title="{{#if noCall}}Texts only: let the player call{{else}}Stop the player calling (texts only){{/if}}"><i class="fas fa-phone-slash"></i></a>
        <a class="ctp-contact-block{{#if blocked}} active{{/if}}" title="{{#if blocked}}Unblock{{else}}Block{{/if}} this number"><i class="fas fa-ban"></i></a>
        <a class="ctp-contact-delete" title="Remove contact"><i class="fas fa-trash"></i></a>
      </li>
      {{#if note}}<li class="ctp-contact-note"><i class="fas fa-note-sticky"></i> {{note}}</li>{{/if}}
    {{else}}
      <li class="ctp-empty">No contacts yet.</li>
    {{/each}}
  </ol>

  <button type="button" class="ctp-contact-add"><i class="fas fa-plus"></i> Add Contact</button>
</div>
