<form class="ctp-quest-form">
  <div class="form-group"><label>Name</label><input type="text" name="name" value="{{quest.name}}" autofocus></div>
  <div class="form-group">
    <label>Status</label>
    <select name="status">{{#each statuses}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
  </div>
  <div class="form-group">
    <label>Image</label>
    <input type="text" name="img" value="{{quest.img}}" placeholder="Optional">
    <button type="button" class="ctp-pick-img" title="Browse"><i class="fas fa-file-image"></i></button>
  </div>
  <div class="form-group stacked"><label>Description</label><textarea name="description" rows="5">{{quest.description}}</textarea></div>
  <div class="form-group"><label>Hidden from players</label><input type="checkbox" name="hidden" {{#if hidden}}checked{{/if}}></div>
</form>
