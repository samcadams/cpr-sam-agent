<form>
  {{#if as}}<p class="ctp-money-as">Paying and billing as <strong>{{as}}</strong>{{#if wallet}}, from {{wallet}}'s sheet{{/if}}.</p>{{/if}}
  <div class="form-group">
    <label>Action</label>
    <select name="kind"><option value="send">Send</option><option value="request">Request</option></select>
  </div>
  <div class="form-group"><label>Amount ({{currency}})</label><input type="number" name="amount" min="1" step="1" autofocus></div>
  <div class="form-group"><label>Note</label><input type="text" name="note" placeholder="Optional"></div>
  <p class="notes">
    {{#if wallet}}Balance: {{balance}} ({{wallet}}){{else}}No wallet on this side: money sent comes from nowhere, money received disappears.{{/if}}
  </p>
</form>
