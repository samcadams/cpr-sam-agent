<form>
  <div class="form-group"><label>Objective</label><input type="text" name="text" value="{{objective.text}}" autofocus></div>
  <div class="form-group">
    <label>Branch of</label>
    <select name="parentId">
      <option value="">— Top level —</option>
      {{#each parents}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{text}}</option>{{/each}}
    </select>
  </div>
  <div class="form-group"><label>Hidden from players</label><input type="checkbox" name="hidden" {{#if objective.hidden}}checked{{/if}}></div>
</form>
