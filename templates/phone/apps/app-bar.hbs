{{!-- An app page's header. Context: appBar() (ui/phone/pages/home.js), plus optional right-side buttons. Called as a block, the block replaces the owner. --}}
<div class="agent-inbox-bar agent-app-bar app-{{id}}">
  <span class="agent-inbox-name"><i class="{{icon}}"></i> {{name}}</span>
  {{#if @partial-block}}{{> @partial-block}}{{else if owner}}<span class="agent-inbox-owner">{{owner}}</span>{{/if}}
</div>
