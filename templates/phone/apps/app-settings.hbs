{{!-- An app's settings (ui/phone/pages/appSettings.js). --}}
<div class="agent-inbox-bar">
  <span class="agent-inbox-name"><i class="{{appSettings.icon}}"></i> {{appSettings.name}} settings</span>
  <a class="agent-icon-btn active" data-action="app-settings" data-app="{{appSettings.app}}" title="Done"><i class="fas fa-check"></i></a>
</div>
<div class="agent-info">
  {{#each appSettings.toggles}}
    <label class="agent-radio{{#if disabled}} disabled{{/if}}{{#if sub}} agent-sub-option{{/if}}">
      <input type="checkbox" {{#if permission}}data-permission="{{key}}"{{else}}data-feature="{{key}}"{{/if}} {{#if on}}checked{{/if}} {{#if disabled}}disabled{{/if}}> {{label}}
    </label>
    {{#if note}}<p class="agent-info-note{{#if sub}} agent-sub-option{{/if}}">{{note}}</p>{{/if}}
  {{/each}}
  {{#if appSettings.hasQuickReplies}}
    <h3 class="agent-info-label">Quick replies</h3>
    <textarea name="quickReplies" rows="5" placeholder="One per line (up to 12), e.g.&#10;OMW&#10;Can't talk&#10;Need backup">{{appSettings.quickReplies}}</textarea>
  {{/if}}
  {{#if appSettings.emoji}}
    <h3 class="agent-info-label">Reaction keyboard</h3>
    <div class="agent-control-field">
      <span class="agent-control-field-head"><span></span>
        <a class="agent-icon-btn{{#if appSettings.emoji.catalog}} active{{/if}}" data-action="emoji-catalog" title="Pick emoji"><i class="far fa-face-smile"></i> Pick</a>
      </span>
      <textarea name="phoneEmoji" rows="3" placeholder="Separated by spaces">{{appSettings.emoji.text}}</textarea>
    </div>
    {{#if appSettings.emoji.catalog}}{{> agent-emoji-catalog appSettings.emoji.catalog}}{{/if}}
    {{#if appSettings.emoji.custom}}
      <button type="button" class="agent-wide-btn" data-action="emoji-reset"><i class="fas fa-rotate-left"></i> Use the GM's set</button>
    {{/if}}
  {{/if}}
</div>
