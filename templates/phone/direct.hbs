<div class="agent-thread-bar">
  <a class="agent-icon-btn" data-action="back" title="Back"><i class="fas fa-chevron-left"></i></a>
  <a class="agent-thread-who" data-action="card" title="{{thread.cardTitle}}">
    {{> agent-avatar thread}}
    <div class="agent-thread-title">
      <div class="agent-thread-name">
        {{thread.name}}
        {{#if thread.hidden}}<i class="fas fa-user-secret agent-hidden-icon" title="Caller ID hidden"></i>{{/if}}
        {{#if thread.blocked}}<i class="fas fa-ban agent-blocked-icon" title="Blocked"></i>{{/if}}
        {{#if thread.hasNotes}}<i class="fas fa-note-sticky agent-notes-icon" title="Notes on the contact card"></i>{{/if}}
      </div>
      <div class="agent-thread-sub">{{#if thread.subtitle}}{{thread.subtitle}}{{else if thread.renamed}}{{thread.renamed}} <i class="fas fa-chevron-right"></i>{{else}}{{thread.cardLabel}} <i class="fas fa-chevron-right"></i>{{/if}}</div>
    </div>
  </a>
  {{#if thread.canShare}}
    <a class="agent-icon-btn" data-action="share-start" title="Share texts to chat"><i class="fas fa-share-from-square"></i></a>
  {{/if}}
  {{#if thread.canCall}}
    <a class="agent-icon-btn" data-action="call" title="Call"><i class="{{@root.appearance.icons.call}}"></i></a>
  {{/if}}
</div>

<div class="agent-messages">
  {{#each thread.messages}}
    {{> agent-message canReact=@root.thread.canReact sharing=@root.thread.sharing}}
  {{else}}
    <div class="agent-empty">No messages yet.</div>
  {{/each}}
</div>

{{#if thread.unreachable}}<div class="agent-unreachable">This number cannot be reached.</div>{{/if}}
{{#with thread.sharing}}
  <div class="agent-share-bar" role="group" aria-label="Share texts to chat">
    <span class="agent-share-count" aria-live="polite">{{#if count}}{{count}} of {{max}} texts{{else}}Tap texts to share (up to {{max}}){{/if}}</span>
    <a class="agent-share-cancel" data-action="share-cancel">Cancel</a>
    {{#if canPost}}<a class="agent-share-post" data-action="share-post"><i class="fas fa-share-from-square"></i> Post to chat</a>{{/if}}
  </div>
{{else}}{{> agent-compose placeholder=thread.placeholder canSend=thread.canSend}}
{{/with}}
