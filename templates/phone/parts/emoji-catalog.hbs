{{!-- The emoji picker for a reaction keyboard. Context: emojiCatalog() (ui/phone/pages/settings.js). --}}
<div class="agent-emoji-catalog">
  {{#each this}}
    <div class="agent-emoji-group">{{name}}</div>
    <div class="agent-emoji-grid">
      {{#each emoji}}<a class="{{#if on}}on{{/if}}" data-action="emoji-toggle" data-emoji="{{e}}" title="{{#if on}}Remove{{else}}Add{{/if}}">{{e}}</a>{{/each}}
    </div>
  {{/each}}
</div>
