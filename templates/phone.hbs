<div class="agent-phone"{{#if screen}} data-screen="{{screen}}"{{/if}}>
  <div class="agent-statusbar" data-action="shade" role="button" aria-expanded="{{#if shade}}true{{else}}false{{/if}}" aria-label="Notifications{{#if shadeCount}}: {{shadeCount}}{{/if}}" title="Notifications (tap or pull down)">
    <span class="agent-brand">{{brand}}{{#if silent}} <i class="fas fa-bell-slash" title="Silent"></i>{{/if}}</span>
    {{#if shadeCount}}<b class="agent-shade-count">{{shadeCount}}</b>{{/if}}
    <span class="agent-time">{{time}}</span>
    {{#if online}}
      <span class="agent-signal"><i></i><i></i><i></i><i></i></span>
    {{else}}
      <span class="agent-signal offline">{{appearance.labels.noSignal}}</span>
    {{/if}}
  </div>
  <div class="agent-date">{{date}}</div>
  {{#if vitals}}
    <div class="agent-vitals vitals-{{vitals.state}}">
      <span class="agent-vitals-beat"><i class="fas fa-heart-pulse"></i> {{vitals.bpm}} BPM</span>
      <span class="agent-vitals-line" aria-hidden="true"></span>
      <span>HP {{vitals.hp}}</span>
      <span class="agent-vitals-label">{{vitals.label}}</span>
    </div>
  {{/if}}
  {{#if ad}}<div class="agent-ad{{#if ad.fresh}} fresh{{/if}}"><b>SPONSORED</b> <span>{{ad.text}}</span></div>{{/if}}

  {{#if callBar}}
    <a class="agent-call-bar" data-action="call-show">
      <i class="fas fa-phone"></i> On a call{{#if callBar.as}} as {{callBar.as}}{{/if}}
      <span {{#if callBar.startedAt}}data-started-at="{{callBar.startedAt}}"{{/if}}>{{callBar.timer}}</span>
      <span class="agent-call-bar-return">Return</span>
    </a>
  {{/if}}

  {{#if tokenPrompt}}
    {{> agent-token-prompt tokenPrompt}}
  {{/if}}

  {{#if page.lock}}
    {{> agent-lock}}
  {{/if}}

  {{!-- Split view (a wide window): the conversation list on the left, the page on the right. --}}
  {{#if split}}<div class="agent-split"><div class="agent-split-list">{{> agent-inbox}}</div><div class="agent-split-main">{{/if}}

  {{#if actingAs}}
    {{> agent-acting-as actingAs}}
  {{/if}}

  {{#if page.none}}
    <div class="agent-empty">No Agent in hand.</div>
  {{/if}}

  {{#if page.incoming}}
    {{> agent-incoming}}
  {{/if}}

  {{#if page.call}}
    {{> agent-call}}
  {{/if}}

  {{#if page.gmCalls}}
    {{> agent-gm-calls}}
  {{/if}}

  {{#if page.direct}}
    {{> agent-direct}}
  {{/if}}

  {{#if page.group}}
    {{> agent-group}}
  {{/if}}

  {{#if page.card}}
    {{> agent-card}}
  {{/if}}

  {{#if page.groupInfo}}
    {{> agent-group-info}}
  {{/if}}

  {{#if page.service}}
    {{> agent-service}}
  {{/if}}

  {{#if page.settings}}
    {{> agent-settings}}
  {{/if}}

  {{#if page.contacts}}
    {{> agent-contacts}}
  {{/if}}

  {{#if page.inbox}}
    {{> agent-inbox}}
  {{/if}}

  {{#if page.quests}}
    {{> agent-quests}}
  {{/if}}

  {{#if page.quest}}
    {{> agent-quest}}
  {{/if}}

  {{#if page.control}}
    {{> agent-control}}
  {{/if}}

  {{!-- The apps (ui/phone/pages/home.js and the pages it opens). --}}
  {{#if page.appSettings}}{{> agent-app-settings}}{{/if}}
  {{#if page.home}}{{> agent-home}}{{/if}}
  {{!-- The open app, by its partial (agent-app-<id>, see apps/manifest.js). --}}
  {{#if citinetOff}}<p class="agent-citinet-off" role="status"><i class="fas fa-satellite-dish"></i> <b>No CitiNet connection.</b> {{citinetOff.name}} needs the CitiNet; apps that don't still work.</p>{{/if}}
  {{#if appPartial}}{{> (lookup . "appPartial")}}{{/if}}

  {{#if page.splitEmpty}}
    <div class="agent-empty agent-split-empty"><i class="{{appearance.icons.messages}}"></i> Pick a conversation.</div>
  {{/if}}
  {{#if split}}</div></div>{{/if}}

  {{#if dock}}
    {{> agent-dock}}
  {{/if}}
  {{#if homeButton}}
    {{!-- Home-screen navigation: no dock, one Home button (each skin draws its own). --}}
    <div class="agent-home-bar">
      <a class="agent-home-button{{#if homeButton.active}} active{{/if}}" data-action="app" data-app="home" title="{{appearance.names.home}}">
        <i class="fas fa-circle-dot"></i>
        {{#if homeButton.badge}}<b class="agent-dock-badge">{{homeButton.badge}}</b>{{/if}}
      </a>
    </div>
  {{/if}}

  <div class="agent-emoji-picker" hidden>
    {{#each emoji}}<a data-action="pick-emoji" data-emoji="{{this}}">{{this}}</a>{{/each}}
  </div>

  {{#if shade}}{{> agent-shade shade}}{{/if}}

  {{#if blood}}<div class="agent-blood {{blood}}" aria-hidden="true"><i></i><i></i><i></i></div>{{/if}}
</div>
